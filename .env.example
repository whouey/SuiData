# Root demo-scripts env (copy to .env; .env is gitignored).

# REQUIRED for demo:setup — a funded testnet wallet (the seller).
SELLER_PRIVATE_KEY=suiprivkey...

# OPTIONAL — enables the LIVE vision-LLM OCR path. Without it, OCR uses the
# cached known-good receipt (scripts/fixtures/receipt.json).
ANTHROPIC_API_KEY=sk-ant-...
# OCR_MODEL=claude-sonnet-4-6

# OPTIONAL — pin the agent wallet instead of the auto-generated one.
# AGENT_PRIVATE_KEY=suiprivkey...

# OPTIONAL — override the deployed package id (defaults to the testnet build).
# PACKAGE_ID=0x...
