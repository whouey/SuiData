# Deployed OtterProof Move package id (testnet).
VITE_PACKAGE_ID=0xc7bc64fe3eb7d93cfcd45949f6816f7a351789aa813e13457a3d1b6d5077cabf

# --- zkLogin (frontend, PUBLIC key — safe to ship to the browser) ---
# Create an Enoki app at https://portal.enoki.mystenlabs.com and a Google OAuth
# client. This PUBLIC key only does zkLogin sign-in (it CANNOT sponsor gas).
VITE_ENOKI_API_KEY=enoki_public_...
VITE_GOOGLE_CLIENT_ID=...apps.googleusercontent.com

# Optional: point the frontend at a non-same-origin sponsor endpoint.
# VITE_SPONSOR_URL=/api/sponsor

# --- Sponsored gas (SERVER ONLY — NEVER prefix with VITE_, never ship to browser) ---
# Used by api/sponsor.ts. Create a SECRET Enoki key, enable Sponsored
# Transactions on it, allowlist this package's identity::create_identity and
# marketplace::list_dataset targets (testnet), and fund the sponsor. Set this in
# Vercel Project → Environment Variables (Server), not in this client .env.
# ENOKI_SECRET_KEY=enoki_private_...
# SPONSOR_PACKAGE_ID=0xc7bc64fe3eb7d93cfcd45949f6816f7a351789aa813e13457a3d1b6d5077cabf
